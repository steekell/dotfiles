#!/bin/sh
# run_once_before_20 — SSH directory hygiene (no private keys in the repo).
set -eu

info() { printf 'ssh(20): %s\n' "$*"; }

home="{{ .chezmoi.homeDir }}"
ssh_dir="${home}/.ssh"

mkdir -p "$ssh_dir"
chmod 700 "$ssh_dir"

# Tighten perms on existing key material if present (never create/overwrite keys here).
if [ -d "$ssh_dir" ]; then
	find "$ssh_dir" -maxdepth 1 -type f \( -name 'id_*' -o -name '*.pem' \) ! -name '*.pub' -exec chmod 600 {} \; 2>/dev/null || true
	find "$ssh_dir" -maxdepth 1 -type f -name '*.pub' -exec chmod 644 {} \; 2>/dev/null || true
	[ -f "${ssh_dir}/config" ] && chmod 600 "${ssh_dir}/config" || true
	[ -f "${ssh_dir}/known_hosts" ] && chmod 644 "${ssh_dir}/known_hosts" || true
fi

# Optional: generate ed25519 only if none exists (commented — enable when wanted).
# if [ ! -f "${ssh_dir}/id_ed25519" ] && command -v ssh-keygen >/dev/null 2>&1; then
#   email="{{ if hasKey . "email" }}{{ .email }}{{ end }}"
#   ssh-keygen -t ed25519 -N "" -C "${email:-$(whoami)@$(hostname)}" -f "${ssh_dir}/id_ed25519"
#   info "generated ${ssh_dir}/id_ed25519"
# fi

info "ok (${ssh_dir})"
