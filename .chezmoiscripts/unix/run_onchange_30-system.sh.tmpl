#!/bin/sh
# run_onchange_30 — OS/distro system tweaks when this script changes.
# Uses stable .system.* ; not for package installs (see 10-packages).
set -eu

info() { printf 'system(30): %s\n' "$*"; }

os="{{ if and (hasKey . "system") (hasKey .system "os") }}{{ .system.os }}{{ else }}{{ .chezmoi.os }}{{ end }}"
arch="{{ if and (hasKey . "system") (hasKey .system "arch") }}{{ .system.arch }}{{ else }}{{ .chezmoi.arch }}{{ end }}"
distro="{{ if and (hasKey . "system") (hasKey .system "distro") }}{{ .system.distro }}{{ end }}"
distro_like="{{ if and (hasKey . "system") (hasKey .system "distroLike") }}{{ .system.distroLike }}{{ end }}"

info "os=${os} arch=${arch} distro=${distro:-?} like=${distro_like:-?}"

# case "$os" in
#   darwin)  … ;;
#   linux)
#     case "$distro" in
#       ubuntu|debian) … ;;
#       arch) … ;;
#     esac
#     ;;
# esac

info "no system tweaks configured yet"
info "ok"
