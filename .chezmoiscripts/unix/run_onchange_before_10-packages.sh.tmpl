#!/bin/sh
# run_onchange_before_10 — install/update packages when this script changes.
# Idempotent host CLIs: nvim + terminal stack + zshrc companions (eza/bat/…).
set -eu

info() { printf 'packages(10): %s\n' "$*"; }
warn() { printf 'packages(10): warning: %s\n' "$*" >&2; }

os="{{ if and (hasKey . "system") (hasKey .system "os") }}{{ .system.os }}{{ else }}{{ .chezmoi.os }}{{ end }}"
distro="{{ if and (hasKey . "system") (hasKey .system "distro") }}{{ .system.distro }}{{ end }}"
distro_like="{{ if and (hasKey . "system") (hasKey .system "distroLike") }}{{ .system.distroLike }}{{ end }}"
home="{{ .chezmoi.homeDir }}"
state_dir="${home}/.config/dotfiles"
manifest="${state_dir}/packages.manifest"

detect_package_manager() {
	if command -v brew >/dev/null 2>&1; then
		printf '%s\n' brew
		return 0
	fi
	if command -v apt-get >/dev/null 2>&1; then
		printf '%s\n' apt
		return 0
	fi
	if command -v dnf >/dev/null 2>&1; then
		printf '%s\n' dnf
		return 0
	fi
	if command -v pacman >/dev/null 2>&1; then
		printf '%s\n' pacman
		return 0
	fi
	if command -v zypper >/dev/null 2>&1; then
		printf '%s\n' zypper
		return 0
	fi
	if command -v apk >/dev/null 2>&1; then
		printf '%s\n' apk
		return 0
	fi
	if command -v pkg >/dev/null 2>&1; then
		printf '%s\n' pkg
		return 0
	fi
	printf '%s\n' unknown
}

run_root() {
	if [ "$(id -u)" -eq 0 ]; then
		"$@"
	elif command -v sudo >/dev/null 2>&1; then
		sudo "$@"
	else
		warn "need root for: $*"
		return 1
	fi
}

PACKAGE_MANAGER="$(detect_package_manager)"
info "os=${os} distro=${distro:-?} like=${distro_like:-?} pm=${PACKAGE_MANAGER}"

mkdir -p "$state_dir"
if [ ! -f "$manifest" ]; then
	printf '# packages installed by dotfiles scripts\n' >"$manifest"
fi

record_pkg() {
	pkg_id="$1"
	grep -qxF "$pkg_id" "$manifest" 2>/dev/null && return 0
	printf '%s\n' "$pkg_id" >>"$manifest"
}

# apt: update once per script run if we need to install something
APT_UPDATED=0
ensure_apt_updated() {
	if [ "$APT_UPDATED" -eq 0 ]; then
		run_root apt-get update -y
		APT_UPDATED=1
	fi
}

# Install one package name via current PM. Args: manifest_suffix package_name [alt_name...]
# Optional env: BREW_CASK=1 → brew install --cask
pm_install() {
	suffix="$1"
	shift
	pkg="$1"
	shift

	case "$PACKAGE_MANAGER" in
		brew)
			if [ "${BREW_CASK:-0}" = "1" ]; then
				brew install --cask "$pkg" || return 1
				record_pkg "brew-cask:${suffix}:${pkg}"
			else
				brew install "$pkg" || return 1
				record_pkg "brew:${suffix}:${pkg}"
			fi
			;;
		apt)
			ensure_apt_updated
			run_root apt-get install -y "$pkg" || {
				# try alternates
				for alt in "$@"; do
					run_root apt-get install -y "$alt" && record_pkg "apt:${suffix}:${alt}" && return 0
				done
				return 1
			}
			record_pkg "apt:${suffix}:${pkg}"
			;;
		dnf)
			run_root dnf install -y "$pkg" || {
				for alt in "$@"; do
					run_root dnf install -y "$alt" && record_pkg "dnf:${suffix}:${alt}" && return 0
				done
				return 1
			}
			record_pkg "dnf:${suffix}:${pkg}"
			;;
		pacman)
			run_root pacman -Syu --needed --noconfirm "$pkg" || {
				for alt in "$@"; do
					run_root pacman -Syu --needed --noconfirm "$alt" && record_pkg "pacman:${suffix}:${alt}" && return 0
				done
				return 1
			}
			record_pkg "pacman:${suffix}:${pkg}"
			;;
		zypper)
			run_root zypper --non-interactive install "$pkg" || {
				for alt in "$@"; do
					run_root zypper --non-interactive install "$alt" && record_pkg "zypper:${suffix}:${alt}" && return 0
				done
				return 1
			}
			record_pkg "zypper:${suffix}:${pkg}"
			;;
		apk)
			run_root apk add --no-cache "$pkg" || {
				for alt in "$@"; do
					run_root apk add --no-cache "$alt" && record_pkg "apk:${suffix}:${alt}" && return 0
				done
				return 1
			}
			record_pkg "apk:${suffix}:${pkg}"
			;;
		pkg)
			run_root pkg install -y "$pkg" || {
				for alt in "$@"; do
					run_root pkg install -y "$alt" && record_pkg "pkg:${suffix}:${alt}" && return 0
				done
				return 1
			}
			record_pkg "pkg:${suffix}:${pkg}"
			;;
		unknown)
			warn "no supported package manager — install ${suffix} manually"
			return 1
			;;
	esac
}

# Packages queued for one transaction (formulas only; casks stay out-of-band).
PACKAGE_QUEUE=""
MANIFEST_QUEUE=""

# ensure_cmd <command> <manifest_suffix> <pkg> [alt_pkgs...]
ensure_cmd() {
	cmd="$1"
	suffix="$2"
	shift 2

	if command -v "$cmd" >/dev/null 2>&1; then
		info "${cmd} already installed: $(command -v "$cmd")"
		return 0
	fi
	case "$PACKAGE_MANAGER" in
		brew|apt|dnf|pacman|zypper|apk|pkg)
			pkg="$1"
			PACKAGE_QUEUE="${PACKAGE_QUEUE} ${pkg}"
			MANIFEST_QUEUE="${MANIFEST_QUEUE} ${PACKAGE_MANAGER}:${suffix}:${pkg}"
			info "${cmd} not found — queued ${PACKAGE_MANAGER} package ${pkg}"
			return 0
			;;
	esac
	if ! pm_install "$suffix" "$@"; then
		warn "failed to install ${cmd} (non-fatal)"
		return 1
	fi

	if command -v "$cmd" >/dev/null 2>&1; then
		info "${cmd} installed: $(command -v "$cmd")"
		return 0
	fi
	warn "${cmd} install finished but not on PATH yet"
	return 1
}

flush_packages() {
	[ -n "$PACKAGE_QUEUE" ] || return 0
	info "installing queued packages in one transaction (${PACKAGE_MANAGER})..."
	# shellcheck disable=SC2086
	case "$PACKAGE_MANAGER" in
		brew) brew install $PACKAGE_QUEUE ;;
		apt) ensure_apt_updated && run_root apt-get install -y $PACKAGE_QUEUE ;;
		dnf) run_root dnf install -y $PACKAGE_QUEUE ;;
		pacman) run_root pacman -Syu --needed --noconfirm $PACKAGE_QUEUE ;;
		zypper) run_root zypper --non-interactive install $PACKAGE_QUEUE ;;
		apk) run_root apk add --no-cache $PACKAGE_QUEUE ;;
		pkg) run_root pkg install -y $PACKAGE_QUEUE ;;
		*) warn "cannot batch-install packages for ${PACKAGE_MANAGER}"; return 1 ;;
	esac || {
		warn "failed to install queued packages (non-fatal)"
		return 1
	}
	for item in $MANIFEST_QUEUE; do
		record_pkg "$item"
	done
	PACKAGE_QUEUE=""
	MANIFEST_QUEUE=""
}

# ensure_brew_cask <command_or_label> <manifest_suffix> <cask> — brew cask only
ensure_brew_cask() {
	label="$1"
	suffix="$2"
	cask="$3"

	# If label looks like a real CLI name and is already present, skip.
	case "$label" in
		font-* | fonts-*) ;;
		*)
			if command -v "$label" >/dev/null 2>&1; then
				info "${label} already installed: $(command -v "$label")"
				return 0
			fi
			;;
	esac

	if [ "$PACKAGE_MANAGER" != "brew" ]; then
		return 1
	fi

	if brew list --cask "$cask" >/dev/null 2>&1; then
		info "brew cask ${cask} already installed"
		record_pkg "brew-cask:${suffix}"
		return 0
	fi

	info "${label}: installing brew cask ${cask}..."
	BREW_CASK=1 pm_install "$suffix" "$cask" || {
		warn "failed brew cask ${cask} (non-fatal)"
		return 1
	}
	if command -v "$label" >/dev/null 2>&1; then
		info "${label} installed: $(command -v "$label")"
	else
		info "brew cask ${cask} installed"
	fi
	return 0
}

# JetBrainsMono Nerd Font (WezTerm font=)
font_jetbrains_mono_nerd_present() {
	if command -v fc-list >/dev/null 2>&1; then
		fc-list 2>/dev/null | grep -qi 'JetBrainsMono.*Nerd' && return 0
	fi
	if [ -d "${home}/Library/Fonts" ]; then
		ls "${home}/Library/Fonts" 2>/dev/null | grep -qi 'JetBrainsMono.*Nerd' && return 0
	fi
	if [ -d "/Library/Fonts" ]; then
		ls "/Library/Fonts" 2>/dev/null | grep -qi 'JetBrainsMono.*Nerd' && return 0
	fi
	if [ "$PACKAGE_MANAGER" = "brew" ] && brew list --cask font-jetbrains-mono-nerd-font >/dev/null 2>&1; then
		return 0
	fi
	return 1
}

ensure_font_jetbrains_mono_nerd() {
	if font_jetbrains_mono_nerd_present; then
		info "JetBrainsMono Nerd Font already present"
		return 0
	fi

	info "JetBrainsMono Nerd Font not found — installing via ${PACKAGE_MANAGER}..."
	case "$PACKAGE_MANAGER" in
		brew)
			BREW_CASK=1 pm_install font-jetbrains-mono-nerd font-jetbrains-mono-nerd-font || {
				warn "failed font-jetbrains-mono-nerd-font (non-fatal)"
				return 1
			}
			;;
		pacman)
			# Arch/community: ttf-jetbrains-mono-nerd (AUR/extra depending on distro)
			pm_install font-jetbrains-mono-nerd ttf-jetbrains-mono-nerd otf-jetbrains-mono-nerd || {
				warn "failed JetBrainsMono Nerd Font package (non-fatal)"
				return 1
			}
			;;
		*)
			warn "no automated JetBrainsMono Nerd Font package for pm=${PACKAGE_MANAGER} — install manually (nerd-fonts)"
			return 1
			;;
	esac

	if font_jetbrains_mono_nerd_present; then
		info "JetBrainsMono Nerd Font installed"
		return 0
	fi
	info "font package installed (may need new session / fc-cache)"
	return 0
}

# --- AUR helper (pacman only) ---
# kanata/herdr live only on the AUR — pacman can never resolve them.
YAY_BOOTSTRAP_TRIED=0
ensure_yay() {
	[ "$PACKAGE_MANAGER" = "pacman" ] || return 1
	command -v yay >/dev/null 2>&1 && return 0
	[ "$YAY_BOOTSTRAP_TRIED" -eq 1 ] && return 1
	YAY_BOOTSTRAP_TRIED=1

	if [ "$(id -u)" -eq 0 ]; then
		warn "cannot bootstrap yay as root — install manually: install AUR helper, then yay -S <pkg>"
		return 1
	fi

	info "yay not found — bootstrapping AUR helper (yay-bin)..."
	run_root pacman -Syu --needed --noconfirm base-devel git || {
		warn "failed to install base-devel/git for yay bootstrap (non-fatal)"
		return 1
	}

	build_dir="$(mktemp -d)"
	if git clone -q https://aur.archlinux.org/yay-bin.git "${build_dir}/yay-bin" \
		&& (cd "${build_dir}/yay-bin" && makepkg -si --noconfirm); then
		rm -rf "$build_dir"
		record_pkg "aur:yay-bin"
	else
		rm -rf "$build_dir"
		warn "failed to bootstrap yay (non-fatal) — install AUR packages manually"
		return 1
	fi
	command -v yay >/dev/null 2>&1
}

# ensure_aur_cmd <command> <manifest_suffix> <pkg> — AUR-only tools (pacman); other PMs use pm_install directly.
ensure_aur_cmd() {
	cmd="$1"
	suffix="$2"
	pkg="$3"

	if command -v "$cmd" >/dev/null 2>&1; then
		info "${cmd} already installed: $(command -v "$cmd")"
		return 0
	fi

	if [ "$PACKAGE_MANAGER" = "pacman" ]; then
		if ensure_yay; then
			yay -S --needed --noconfirm "$pkg" || {
				warn "failed to install ${cmd} via yay (non-fatal)"
				return 1
			}
			record_pkg "yay:${suffix}:${pkg}"
		else
			warn "${cmd} needs the AUR — install manually: yay -S ${pkg}"
			return 1
		fi
	elif ! pm_install "$suffix" "$pkg"; then
		warn "failed to install ${cmd} (non-fatal)"
		return 1
	fi

	if command -v "$cmd" >/dev/null 2>&1; then
		info "${cmd} installed: $(command -v "$cmd")"
		return 0
	fi
	warn "${cmd} install finished but not on PATH yet"
	return 1
}

# Packages

# 1. Terminal, shell, and desktop interaction

# Terminal GUI / fonts (brew casks; Linux falls back to ensure_cmd via pm after queue)
# wezterm: brew cask; Linux package name usually wezterm
if ! ensure_brew_cask wezterm wezterm wezterm; then
	ensure_cmd wezterm wezterm wezterm || true
fi

# Clipboard: skip macOS (pbcopy); on other Unix try both toolkits (non-fatal).
case "${os}" in
	darwin | windows) ;;
	*)
		ensure_cmd xclip xclip xclip || true
		ensure_cmd wl-copy wl-clipboard wl-clipboard || true
		;;
esac
ensure_font_jetbrains_mono_nerd || true

ensure_cmd bash bash bash || true
ensure_cmd zsh zsh zsh || true
ensure_cmd nushell nu nushell nushell || true
ensure_cmd zellij zellij zellij || true
ensure_aur_cmd herdr herdr herdr || true
ensure_cmd eza eza eza || true
ensure_cmd zoxide zoxide zoxide || true
# Debian/Ubuntu often ship `batcat` instead of `bat`.
if command -v bat >/dev/null 2>&1 || command -v batcat >/dev/null 2>&1; then
	if command -v bat >/dev/null 2>&1; then
		info "bat already installed: $(command -v bat)"
	else
		info "bat already installed: $(command -v batcat) (batcat)"
	fi
else
	ensure_cmd bat bat bat || true
fi
ensure_cmd less less less || true
ensure_cmd btop btop btop || true
ensure_cmd ncdu ncdu ncdu || true

# 2. Git and development tools
ensure_cmd git git git || true
ensure_cmd gh github-cli github-cli gh || true
ensure_cmd lazygit lazygit lazygit || true
ensure_cmd gitui gitui gitui || true
ensure_cmd tig tig tig || true

# 3. Search, navigation, and package utilities
ensure_cmd grep grep grep || true
ensure_cmd fzf fzf fzf || true
ensure_cmd rg ripgrep ripgrep || true
ensure_cmd which which which || true

# 4. Files, archives, transfer, backup, and trash
ensure_cmd yazi yazi yazi || true
ensure_cmd mc mc mc || true
ensure_cmd unrar unrar unrar || true
ensure_cmd unzip unzip unzip || true
ensure_cmd zip zip zip || true
ensure_cmd 7zz 7zip 7zip || true
ensure_cmd wget wget wget || true
ensure_cmd curl curl curl || true
ensure_cmd rsync rsync rsync || true
ensure_cmd restic restic restic || true
ensure_cmd trash-empty trash-cli trash-cli || true

# 5. Nvim
ensure_cmd nvim neovim neovim editors/neovim || true
ensure_cmd tree-sitter tree-sitter-cli tree-sitter-cli tree-sitter || true
ensure_cmd bash-language-server bash-language-server bash-language-server || true
ensure_cmd lua-language-server lua-language-server lua-language-server || true
ensure_cmd pyright pyright pyright || true
ensure_cmd typescript-language-server typescript-language-server typescript-language-server || true
ensure_cmd vscode-json-languageserver vscode-json-languageserver vscode-json-languageserver || true
ensure_cmd marksman marksman marksman || true

# 6. Documentation terminal help and visualiser
ensure_cmd man man-db man-db || true
ensure_cmd tldr tealdeer tealdeer || true
ensure_cmd glow glow glow || true

# 7. Node.js and JavaScript tooling (nodejs-lts-jod provides Node.js v22 on Arch)
ensure_cmd node nodejs-lts-jod nodejs || true
ensure_cmd npm npm npm || true
ensure_cmd pnpm pnpm pnpm || true

# Install all packages queued by the categorized ensure_cmd calls above.
flush_packages || true
