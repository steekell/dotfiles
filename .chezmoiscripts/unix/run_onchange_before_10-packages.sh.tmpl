#!/bin/sh
# run_onchange_before_10 — install/update packages when this script changes.
# Idempotent tools for nvim workflow: neovim, yazi, fzf, ripgrep.
set -eu

info() { printf 'packages(10): %s\n' "$*"; }
warn() { printf 'packages(10): warning: %s\n' "$*" >&2; }

os="{{ if and (hasKey . "system") (hasKey .system "os") }}{{ .system.os }}{{ else }}{{ .chezmoi.os }}{{ end }}"
distro="{{ if and (hasKey . "system") (hasKey .system "distro") }}{{ .system.distro }}{{ end }}"
distro_like="{{ if and (hasKey . "system") (hasKey .system "distroLike") }}{{ .system.distroLike }}{{ end }}"
home="{{ .chezmoi.homeDir }}"
state_dir="${home}/.config/dotfiles"
manifest="${state_dir}/packages.manifest"

detect_package_manager() {
	if command -v brew >/dev/null 2>&1; then
		printf '%s\n' brew
		return 0
	fi
	if command -v apt-get >/dev/null 2>&1; then
		printf '%s\n' apt
		return 0
	fi
	if command -v dnf >/dev/null 2>&1; then
		printf '%s\n' dnf
		return 0
	fi
	if command -v pacman >/dev/null 2>&1; then
		printf '%s\n' pacman
		return 0
	fi
	if command -v zypper >/dev/null 2>&1; then
		printf '%s\n' zypper
		return 0
	fi
	if command -v apk >/dev/null 2>&1; then
		printf '%s\n' apk
		return 0
	fi
	if command -v pkg >/dev/null 2>&1; then
		printf '%s\n' pkg
		return 0
	fi
	printf '%s\n' unknown
}

run_root() {
	if [ "$(id -u)" -eq 0 ]; then
		"$@"
	elif command -v sudo >/dev/null 2>&1; then
		sudo "$@"
	else
		warn "need root for: $*"
		return 1
	fi
}

PACKAGE_MANAGER="$(detect_package_manager)"
info "os=${os} distro=${distro:-?} like=${distro_like:-?} pm=${PACKAGE_MANAGER}"

mkdir -p "$state_dir"
if [ ! -f "$manifest" ]; then
	printf '# packages installed by dotfiles scripts\n' >"$manifest"
fi

record_pkg() {
	pkg_id="$1"
	grep -qxF "$pkg_id" "$manifest" 2>/dev/null && return 0
	printf '%s\n' "$pkg_id" >>"$manifest"
}

# apt: update once per script run if we need to install something
APT_UPDATED=0
ensure_apt_updated() {
	if [ "$APT_UPDATED" -eq 0 ]; then
		run_root apt-get update -y
		APT_UPDATED=1
	fi
}

# Install one package name via current PM. Args: manifest_suffix package_name [alt_name...]
pm_install() {
	suffix="$1"
	shift
	pkg="$1"
	shift

	case "$PACKAGE_MANAGER" in
		brew)
			brew install "$pkg" || return 1
			record_pkg "brew:${suffix}"
			;;
		apt)
			ensure_apt_updated
			run_root apt-get install -y "$pkg" || {
				# try alternates
				for alt in "$@"; do
					run_root apt-get install -y "$alt" && record_pkg "apt:${suffix}" && return 0
				done
				return 1
			}
			record_pkg "apt:${suffix}"
			;;
		dnf)
			run_root dnf install -y "$pkg" || return 1
			record_pkg "dnf:${suffix}"
			;;
		pacman)
			run_root pacman -Syu --needed --noconfirm "$pkg" || return 1
			record_pkg "pacman:${suffix}"
			;;
		zypper)
			run_root zypper --non-interactive install "$pkg" || return 1
			record_pkg "zypper:${suffix}"
			;;
		apk)
			run_root apk add --no-cache "$pkg" || return 1
			record_pkg "apk:${suffix}"
			;;
		pkg)
			run_root pkg install -y "$pkg" || {
				for alt in "$@"; do
					run_root pkg install -y "$alt" && record_pkg "pkg:${suffix}" && return 0
				done
				return 1
			}
			record_pkg "pkg:${suffix}"
			;;
		unknown)
			warn "no supported package manager — install ${suffix} manually"
			return 1
			;;
	esac
}

# Packages queued for one transaction.
PACKAGE_QUEUE=""
MANIFEST_QUEUE=""

# ensure_cmd <command> <manifest_suffix> <pkg> [alt_pkgs...]
ensure_cmd() {
	cmd="$1"
	suffix="$2"
	shift 2

	if command -v "$cmd" >/dev/null 2>&1; then
		info "${cmd} already installed: $(command -v "$cmd")"
		return 0
	fi
	case "$PACKAGE_MANAGER" in
		brew|apt|dnf|pacman|zypper|apk|pkg)
			pkg="$1"
			PACKAGE_QUEUE="${PACKAGE_QUEUE} ${pkg}"
			MANIFEST_QUEUE="${MANIFEST_QUEUE} ${PACKAGE_MANAGER}:${suffix}"
			info "${cmd} not found — queued ${PACKAGE_MANAGER} package ${pkg}"
			return 0
			;;
	esac
	if ! pm_install "$suffix" "$@"; then
		warn "failed to install ${cmd} (non-fatal)"
		return 1
	fi

	if command -v "$cmd" >/dev/null 2>&1; then
		info "${cmd} installed: $(command -v "$cmd")"
		return 0
	fi
	warn "${cmd} install finished but not on PATH yet"
	return 1
}

flush_packages() {
	[ -n "$PACKAGE_QUEUE" ] || return 0
	info "installing queued packages in one transaction (${PACKAGE_MANAGER})..."
	# shellcheck disable=SC2086
	case "$PACKAGE_MANAGER" in
		brew) brew install $PACKAGE_QUEUE ;;
		apt) ensure_apt_updated && run_root apt-get install -y $PACKAGE_QUEUE ;;
		dnf) run_root dnf install -y $PACKAGE_QUEUE ;;
		pacman) run_root pacman -Syu --needed --noconfirm $PACKAGE_QUEUE ;;
		zypper) run_root zypper --non-interactive install $PACKAGE_QUEUE ;;
		apk) run_root apk add --no-cache $PACKAGE_QUEUE ;;
		pkg) run_root pkg install -y $PACKAGE_QUEUE ;;
		*) warn "cannot batch-install packages for ${PACKAGE_MANAGER}"; return 1 ;;
	esac || {
		warn "failed to install queued packages (non-fatal)"
		return 1
	}
	for item in $MANIFEST_QUEUE; do
		record_pkg "$item"
	done
}




ensure_cmd nvim neovim neovim || true
ensure_cmd yazi yazi yazi || true
ensure_cmd fzf fzf fzf || true
ensure_cmd rg ripgrep ripgrep || true

flush_packages || true
