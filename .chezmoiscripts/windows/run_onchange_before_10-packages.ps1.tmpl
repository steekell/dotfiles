# run_onchange_before_10 — packages when this script changes.
# Idempotent host CLIs: nvim workflow + terminal stack (wezterm, zellij, herdr).
$ErrorActionPreference = 'Stop'

function Write-PkgInfo([string]$Message) {
    Write-Host "packages(10): $Message"
}
function Write-PkgWarn([string]$Message) {
    Write-Warning "packages(10): $Message"
}

$os = '{{ if and (hasKey . "system") (hasKey .system "os") }}{{ .system.os }}{{ else }}{{ .chezmoi.os }}{{ end }}'
$homeDir = '{{ .chezmoi.homeDir }}'
$stateDir = Join-Path $homeDir '.config\dotfiles'
$manifest = Join-Path $stateDir 'packages.manifest'

function Get-PackageManager {
    if (Get-Command winget -ErrorAction SilentlyContinue) { return 'winget' }
    if (Get-Command choco -ErrorAction SilentlyContinue) { return 'choco' }
    if (Get-Command scoop -ErrorAction SilentlyContinue) { return 'scoop' }
    return 'unknown'
}

function Refresh-Path {
    $env:Path = [System.Environment]::GetEnvironmentVariable('Path', 'Machine') + ';' +
                [System.Environment]::GetEnvironmentVariable('Path', 'User')
}

function Add-Manifest([string]$PkgId) {
    if (-not (Test-Path -LiteralPath $manifest)) {
        Set-Content -Path $manifest -Value "# packages installed by dotfiles scripts`n" -Encoding utf8
    }
    $existing = @(Get-Content -LiteralPath $manifest -ErrorAction SilentlyContinue)
    if ($existing -contains $PkgId) { return }
    Add-Content -LiteralPath $manifest -Value $PkgId -Encoding utf8
}

function Test-Cmd([string]$Name) {
    return [bool](Get-Command $Name -ErrorAction SilentlyContinue)
}

# Ensure-Cmd -Command nvim -WingetId Neovim.Neovim -ChocoName neovim -ScoopName neovim
# Empty WingetId/ChocoName/ScoopName = skip that PM path
function Ensure-Cmd {
    param(
        [Parameter(Mandatory = $true)][string] $Command,
        [string] $WingetId = '',
        [string] $ChocoName = '',
        [string] $ScoopName = ''
    )

    if (Test-Cmd $Command) {
        Write-PkgInfo "$Command already installed: $((Get-Command $Command).Source)"
        return
    }

    $pm = Get-PackageManager
    Write-PkgInfo "$Command not found — installing via $pm..."

    switch ($pm) {
        'winget' {
            if ([string]::IsNullOrWhiteSpace($WingetId)) {
                Write-PkgWarn "no winget id for $Command — install manually"
                return
            }
            & winget install --id $WingetId -e --accept-source-agreements --accept-package-agreements
            Add-Manifest "winget:$WingetId"
        }
        'choco' {
            if ([string]::IsNullOrWhiteSpace($ChocoName)) {
                Write-PkgWarn "no choco name for $Command — install manually"
                return
            }
            & choco install $ChocoName -y
            Add-Manifest "choco:$ChocoName"
        }
        'scoop' {
            if ([string]::IsNullOrWhiteSpace($ScoopName)) {
                Write-PkgWarn "no scoop name for $Command — install manually"
                return
            }
            & scoop install $ScoopName
            Add-Manifest "scoop:$ScoopName"
        }
        default {
            Write-PkgWarn "no supported package manager — install $Command manually"
            return
        }
    }

    Refresh-Path
    if (Test-Cmd $Command) {
        Write-PkgInfo "$Command installed: $((Get-Command $Command).Source)"
    } else {
        Write-PkgWarn "$Command install finished but not on PATH yet — open a new terminal"
    }
}

function Ensure-Herdr {
    if (Test-Cmd 'herdr') {
        Write-PkgInfo "herdr already installed: $((Get-Command herdr).Source)"
        return
    }

    Write-PkgInfo 'herdr not found — trying winget/scoop, else official install.ps1...'
    $pm = Get-PackageManager
    try {
        switch ($pm) {
            'winget' {
                # May not exist yet; fall through on failure
                & winget install --id herdr.herdr -e --accept-source-agreements --accept-package-agreements 2>$null
                if ($LASTEXITCODE -eq 0) { Add-Manifest 'winget:herdr.herdr' }
            }
            'scoop' {
                & scoop install herdr 2>$null
                if ($LASTEXITCODE -eq 0) { Add-Manifest 'scoop:herdr' }
            }
        }
    } catch {
        # continue to official installer
    }

    Refresh-Path
    if (Test-Cmd 'herdr') {
        Write-PkgInfo "herdr installed: $((Get-Command herdr).Source)"
        return
    }

    try {
        # Official Windows beta installer (herdr.dev)
        Invoke-Expression (Invoke-RestMethod -Uri 'https://herdr.dev/install.ps1')
        Add-Manifest 'herdr:install.ps1'
    } catch {
        Write-PkgWarn "herdr install failed: $_ — see https://herdr.dev (non-fatal)"
        return
    }

    Refresh-Path
    if (Test-Cmd 'herdr') {
        Write-PkgInfo "herdr installed: $((Get-Command herdr).Source)"
    } else {
        Write-PkgWarn 'herdr install finished but not on PATH yet — open a new terminal'
    }
}

$pm = Get-PackageManager
Write-PkgInfo "os=$os pm=$pm"

New-Item -ItemType Directory -Force -Path $stateDir | Out-Null
if (-not (Test-Path -LiteralPath $manifest)) {
    Set-Content -Path $manifest -Value "# packages installed by dotfiles scripts`n" -Encoding utf8
}

$specs = @(
    @{ Command = 'nvim'; WingetId = 'Neovim.Neovim'; ChocoName = 'neovim'; ScoopName = 'neovim' }
    @{ Command = 'yazi'; WingetId = 'sxyazi.yazi'; ChocoName = 'yazi'; ScoopName = 'yazi' }
    @{ Command = 'fzf'; WingetId = 'junegunn.fzf'; ChocoName = 'fzf'; ScoopName = 'fzf' }
    @{ Command = 'rg'; WingetId = 'BurntSushi.ripgrep.MSVC'; ChocoName = 'ripgrep'; ScoopName = 'ripgrep' }
    @{ Command = 'wezterm'; WingetId = 'wez.WezTerm'; ChocoName = 'wezterm'; ScoopName = 'wezterm' }
    @{ Command = 'zellij'; WingetId = ''; ChocoName = ''; ScoopName = 'zellij' }
)

foreach ($s in $specs) {
    try {
        Ensure-Cmd @s
    } catch {
        Write-PkgWarn "Ensure-Cmd $($s.Command) failed: $_"
    }
}

try {
    Ensure-Herdr
} catch {
    Write-PkgWarn "Ensure-Herdr failed: $_"
}

# Nerd font: no reliable winget id — manual / nerd-fonts release
Write-PkgInfo 'hint: install JetBrainsMono Nerd Font manually if missing (WezTerm font=JetBrainsMono Nerd Font)'

Write-PkgInfo 'ok'
