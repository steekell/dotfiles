## ==8. Fonctions

### Yazi avec suivi du repertoire
function e() {
  if ! command -v yazi >/dev/null 2>&1; then
    echo "yazi not installed" >&2
    return 1
  fi
  local tmp cwd
  tmp="$(mktemp)"
  yazi --cwd-file="$tmp" "$@"
  cwd="$(cat "$tmp" 2>/dev/null)"
  [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && cd "$cwd"
  rm -f "$tmp"
}

### Créer un dossier et y entrer
function mkcd {
  mkdir -p "$1" && cd "$1"
}

### Afficher les processus consommateurs (top 10 cpu)
function topcpu {
  if ps aux --sort=-%cpu >/dev/null 2>&1; then
    ps aux --sort=-%cpu | head -11
  else
    # macOS / BSD: no GNU sort flag
    ps aux | sort -nrk 3 | head -11
  fi
}

## ==9. Plugins / sources externes

### fzf : raccourcis clavier (Ctrl+T, Ctrl+R, Alt+C) — paths multi-OS
for _fzf_kb in \
  "${HOME}/.fzf/shell/key-bindings.zsh" \
  /opt/homebrew/opt/fzf/shell/key-bindings.zsh \
  /usr/local/opt/fzf/shell/key-bindings.zsh \
  /home/linuxbrew/.linuxbrew/opt/fzf/shell/key-bindings.zsh \
  /usr/share/fzf/key-bindings.zsh \
  /usr/share/doc/fzf/examples/key-bindings.zsh
do
  if [[ -f "${_fzf_kb}" ]]; then
    # shellcheck disable=SC1090
    source "${_fzf_kb}"
    break
  fi
done
for _fzf_cp in \
  "${HOME}/.fzf/shell/completion.zsh" \
  /opt/homebrew/opt/fzf/shell/completion.zsh \
  /usr/local/opt/fzf/shell/completion.zsh \
  /home/linuxbrew/.linuxbrew/opt/fzf/shell/completion.zsh \
  /usr/share/fzf/completion.zsh \
  /usr/share/doc/fzf/examples/completion.zsh
do
  if [[ -f "${_fzf_cp}" ]]; then
    # shellcheck disable=SC1090
    source "${_fzf_cp}"
    break
  fi
done
unset _fzf_kb _fzf_cp

### which-alias via fzf : Ctrl+Space
if command -v fzf >/dev/null 2>&1; then
  alias-widget() {
    local selected
    selected=$(
      alias | sort | fzf \
        --height 50% \
        --reverse \
        --border rounded \
        --prompt ' alias> ' \
        --preview 'echo {} | sed "s/.*=//"' \
        --preview-window 'down:2:wrap'
    )
    [[ -z $selected ]] && { zle redisplay; return; }
    LBUFFER+="${selected%%=*}"
    zle redisplay
  }
  zle -N alias-widget
  bindkey '^ ' alias-widget
fi

### scripts fzf : Ctrl+X → parcourir scripts python (si le dossier existe)
if command -v fzf >/dev/null 2>&1 && [[ -d /data/scripts/python ]]; then
  scripts-widget() {
    local file base
    base=/data/scripts/python
    file=$(
      find "$base" -type f | sed "s|$base/||" | sort | fzf \
        --height 50% \
        --reverse \
        --border rounded \
        --prompt ' python > ' \
        --preview "command -v bat >/dev/null && bat --color=always --style=plain --paging=never $base/{} || cat $base/{}" \
        --preview-window 'right:60%:wrap'
    )
    [[ -z $file ]] && { zle redisplay; return; }
    LBUFFER+="python $base/$file"
    zle redisplay
  }
  zle -N scripts-widget
  bindkey '^X' scripts-widget
fi

# zoxide init (if installed)
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi
