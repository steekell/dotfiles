# ~/.zshrc — multi-platform (macOS, Linux/WSL, *BSD, Git Bash/MSYS).
# Runtime detection only (no chezmoi OS branches). Apply once → same file everywhere.

## Sommaire
## ==1. Environnement & PATH
## ==2. Options zsh
## ==3. Historique
## ==4. Complétion
## ==5. Keybindings
## ==6. Prompt
## ==7. Aliases
## ==8. Fonctions
## ==9. Plugins / sources externes

## ==1. Environnement & PATH

export LANG="${LANG:-fr_FR.UTF-8}"
export LC_ALL="${LC_ALL:-fr_FR.UTF-8}"

# Browser: prefer brave-origin, then common fallbacks
if command -v brave-origin >/dev/null 2>&1; then
  export BROWSER=brave-origin
elif command -v brave >/dev/null 2>&1; then
  export BROWSER=brave
elif command -v open >/dev/null 2>&1; then
  export BROWSER=open
elif command -v xdg-open >/dev/null 2>&1; then
  export BROWSER=xdg-open
fi

# Homebrew if present (Apple Silicon, Intel, Linuxbrew)
for _brew in \
  /opt/homebrew/bin/brew \
  /usr/local/bin/brew \
  /home/linuxbrew/.linuxbrew/bin/brew \
  "${HOME}/.linuxbrew/bin/brew"
do
  if [ -x "${_brew}" ]; then
    eval "$("${_brew}" shellenv)"
    break
  fi
done
unset _brew

# User binaries (chezmoi, pipx, rustup, cargo, etc.)
typeset -U path PATH
path=(
  "${HOME}/.local/bin"
  "${HOME}/.cargo/bin"
  $path
)

# Windows-style user bin (Git Bash / MSYS / Cygwin)
case "$(uname -s 2>/dev/null)" in
  MINGW* | MSYS* | CYGWIN*)
    path=("${HOME}/bin" $path)
    ;;
esac

# bun (if installed)
if [ -s "${HOME}/.bun/_bun" ]; then
  # shellcheck disable=SC1091
  . "${HOME}/.bun/_bun"
fi
if [ -d "${HOME}/.bun/bin" ]; then
  export BUN_INSTALL="${HOME}/.bun"
  path=("${BUN_INSTALL}/bin" $path)
fi

export PATH

# Prefer nvim when available
if command -v nvim >/dev/null 2>&1; then
  export EDITOR=nvim
  export VISUAL=nvim
elif command -v vim >/dev/null 2>&1; then
  export EDITOR=vim
  export VISUAL=vim
else
  export EDITOR="${EDITOR:-vi}"
  export VISUAL="${VISUAL:-vi}"
fi

## ==2. Options zsh

setopt AUTO_CD              # taper un chemin suffit pour y aller
setopt AUTO_PUSHD           # cd empile dans la pile de dirs
setopt PUSHD_IGNORE_DUPS    # pas de doublons dans la pile
setopt CORRECT              # correction de commandes
setopt NO_BEEP              # silence
setopt EXTENDED_GLOB        # globs avancés
setopt GLOB_DOTS            # les globs matchent les fichiers cachés
setopt INTERACTIVE_COMMENTS # autoriser # dans le shell interactif
setopt PROMPT_SUBST         # évaluer $() dans le prompt à chaque affichage

## ==3. Historique

HISTFILE="${HOME}/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000

setopt SHARE_HISTORY        # partage entre sessions
setopt HIST_IGNORE_DUPS     # pas de lignes dupliquées consécutives
setopt HIST_IGNORE_SPACE    # ignorer les lignes précédées d'un espace
setopt HIST_VERIFY          # confirmer avant d'exécuter une expansion !
setopt HIST_REDUCE_BLANKS   # supprimer les espaces superflus

## ==4. Complétion

autoload -Uz compinit && compinit

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*:descriptions' format '%F{#89b4fa}── %d%f'
zstyle ':completion:*' group-name ''

## ==5. Keybindings

bindkey -v                           # mode vi

### Délai réduit pour la détection de la touche Escape
KEYTIMEOUT=1

### Bindings Ctrl conservés malgré le mode vi (kanata : lalt→lCtrl sur certaines machines)
bindkey '^R' history-incremental-search-backward
bindkey '^A' beginning-of-line
bindkey '^E' end-of-line
bindkey '^K' kill-line
bindkey '^U' backward-kill-line
bindkey '^W' backward-kill-word
bindkey '^P' up-line-or-history
bindkey '^N' down-line-or-history

## ==6. Prompt

### Indicateur de mode vi dans le prompt (insert / normal)
function _vi_mode_indicator {
  case "${KEYMAP}" in
    vicmd) echo '%F{#f9e2af}[N]%f ';;
    *)     echo '';;
  esac
}

function zle-line-init zle-keymap-select {
  zle reset-prompt
}
zle -N zle-line-init
zle -N zle-keymap-select

### Prompt : chemin · flèche (couleur selon code retour)
PROMPT='%F{#89b4fa}%~%f $(_vi_mode_indicator)%(?,%F{#a6e3a1},%F{#f38ba8})❯%f '

## ==7. Aliases

### Gestionnaire de paquets (détection runtime — mêmes raccourcis partout)
# pup=update  pin=install  prm=remove  prmd=remove+deps  prma=purge unused
# psea=search  plis=list/search local  pinf=info  pinfin=info local  plisv=list files  plisin=owns file
# prmaforce=orphans/autoremove force  pclean=cache light  pcleana=cache full
_pm=
if command -v brew >/dev/null 2>&1; then
  _pm=brew
elif command -v pacman >/dev/null 2>&1; then
  _pm=pacman
elif command -v apt-get >/dev/null 2>&1; then
  _pm=apt
elif command -v dnf >/dev/null 2>&1; then
  _pm=dnf
elif command -v zypper >/dev/null 2>&1; then
  _pm=zypper
elif command -v apk >/dev/null 2>&1; then
  _pm=apk
elif command -v pkg >/dev/null 2>&1; then
  _pm=pkg
fi

case "${_pm}" in
  brew)
    alias pup='brew update && brew upgrade'
    alias pin='brew install'
    alias prm='brew uninstall'
    alias prmd='brew uninstall --zap'
    alias prma='brew autoremove'
    alias psea='brew search'
    alias plis='brew list'
    alias pinf='brew info'
    alias pinfin='brew info --installed'
    alias plisv='brew list --verbose'
    alias plisin='brew uses --installed'   # inverse of owns; use: brew --prefix formula
    alias pclean='brew cleanup'
    alias pcleana='brew cleanup -s'
    ;;
  pacman)
    alias pup='sudo pacman -Syu'
    alias pin='sudo pacman -S'
    alias prm='sudo pacman -R'
    alias prmd='sudo pacman -Rs'
    alias prma='sudo pacman -Rns'
    alias psea='pacman -Ss'
    alias plis='pacman -Qs'
    alias pinf='pacman -Si'
    alias pinfin='pacman -Qi'
    alias plisv='pacman -Ql'
    alias plisin='pacman -Qo'
    alias prmaforce='sudo pacman -Rns $(pacman -Qtdq)'
    alias pclean='sudo pacman -Sc'
    alias pcleana='sudo pacman -Scc'
    ;;
  apt)
    alias pup='sudo apt-get update && sudo apt-get upgrade'
    alias pin='sudo apt-get install'
    alias prm='sudo apt-get remove'
    alias prmd='sudo apt-get autoremove --purge'
    alias prma='sudo apt-get autoremove --purge'
    alias psea='apt-cache search'
    alias plis='dpkg -l'
    alias pinf='apt-cache show'
    alias pinfin='dpkg -s'
    alias plisv='dpkg -L'
    alias plisin='dpkg -S'
    alias pclean='sudo apt-get clean'
    alias pcleana='sudo apt-get clean && sudo apt-get autoclean'
    ;;
  dnf)
    alias pup='sudo dnf upgrade'
    alias pin='sudo dnf install'
    alias prm='sudo dnf remove'
    alias prmd='sudo dnf remove'
    alias prma='sudo dnf autoremove'
    alias psea='dnf search'
    alias plis='dnf list installed'
    alias pinf='dnf info'
    alias pinfin='dnf info installed'
    alias plisv='rpm -ql'
    alias plisin='rpm -qf'
    alias pclean='sudo dnf clean packages'
    alias pcleana='sudo dnf clean all'
    ;;
  zypper)
    alias pup='sudo zypper refresh && sudo zypper update'
    alias pin='sudo zypper install'
    alias prm='sudo zypper remove'
    alias prmd='sudo zypper remove -u'
    alias prma='sudo zypper packages --unneeded'
    alias psea='zypper search'
    alias plis='zypper search -i'
    alias pinf='zypper info'
    alias pinfin='zypper info'
    alias plisv='rpm -ql'
    alias plisin='rpm -qf'
    alias pclean='sudo zypper clean'
    alias pcleana='sudo zypper clean --all'
    ;;
  apk)
    alias pup='sudo apk update && sudo apk upgrade'
    alias pin='sudo apk add'
    alias prm='sudo apk del'
    alias prmd='sudo apk del'
    alias prma='sudo apk cache clean'
    alias psea='apk search'
    alias plis='apk info -e'
    alias pinf='apk info'
    alias pinfin='apk info'
    alias plisv='apk info -L'
    alias plisin='apk info -W'
    alias pclean='sudo apk cache clean'
    alias pcleana='sudo apk cache clean'
    ;;
  pkg)
    # FreeBSD pkg
    alias pup='sudo pkg update && sudo pkg upgrade'
    alias pin='sudo pkg install'
    alias prm='sudo pkg delete'
    alias prmd='sudo pkg delete -R'
    alias prma='sudo pkg autoremove'
    alias psea='pkg search'
    alias plis='pkg info'
    alias pinf='pkg info'
    alias pinfin='pkg info'
    alias plisv='pkg info -l'
    alias plisin='pkg which'
    alias pclean='sudo pkg clean'
    alias pcleana='sudo pkg clean -a'
    ;;
esac
unset _pm

