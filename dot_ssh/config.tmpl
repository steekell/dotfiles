# ~/.ssh/config — managed by chezmoi (no private keys in the repo).
# Host blocks: add below or use Include.

Host *
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_ed25519
  AddKeysToAgent yes
  {{- if eq .chezmoi.os "darwin" }}
  UseKeychain yes
  {{- end }}
  ServerAliveInterval 60
  ServerAliveCountMax 3
  HashKnownHosts yes

# Example:
# Host github.com
#   HostName github.com
#   User git
#   IdentityFile ~/.ssh/id_ed25519
