# ~/.ssh/config — multi-platform (no private keys in the repo).
# OpenSSH on macOS, Linux/*BSD, Windows OpenSSH.

Host *
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_ed25519
  AddKeysToAgent yes
  ServerAliveInterval 60
  ServerAliveCountMax 3
  HashKnownHosts yes
  {{- if eq .chezmoi.os "darwin" }}
  # macOS only (ignored / invalid on Linux & Windows OpenSSH)
  UseKeychain yes
  {{- end }}
  {{- if eq .chezmoi.os "windows" }}
  # Windows OpenSSH: prefer explicit agent when available
  # IdentityAgent can be set per-host if using 1Password / Pageant bridge
  {{- end }}

# Example:
# Host github.com
#   HostName github.com
#   User git
#   IdentityFile ~/.ssh/id_ed25519
