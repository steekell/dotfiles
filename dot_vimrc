" ~/.vimrc — multi-platform fallback when nvim is unavailable
" Works on Unix and Windows (gVim / terminal Vim).

set nocompatible
set number
set expandtab
set shiftwidth=2
set tabstop=2
set ignorecase
set smartcase
set encoding=utf-8
set fileformats=unix,dos,mac

" Swap under home (portable; mode bit ignored on Windows)
let s:swap = expand('~/.vim/swap')
if !isdirectory(s:swap)
  silent! call mkdir(s:swap, 'p', 0700)
endif
let &directory = s:swap . '//'

" Clipboard: best effort without hard OS deps
if has('clipboard')
  if has('unnamedplus')
    set clipboard=unnamedplus
  else
    set clipboard=unnamed
  endif
endif
